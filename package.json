{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "node ./scripts/dev-local.mjs",
    "dev:web": "pnpm --filter @workspace/lumina run dev",
    "dev:api": "pnpm --filter @workspace/api-server run dev",
    "db:push": "pnpm --filter @workspace/db run push",
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && node ./scripts/build.mjs",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "lint": "eslint .",
    "check:provider": "node ./scripts/check-provider.mjs",
    "verify:lightbox": "node scripts/browser/verify-lightbox.mjs",
    "verify:flow": "node scripts/browser/verify-flow.mjs"
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.11"
  }
}