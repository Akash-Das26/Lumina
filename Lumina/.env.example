# Copy this file to .env before running `pnpm dev`.
# Do not commit a real .env file.

# A local PostgreSQL database used for conversations and messages.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lumina

# Use OpenAI directly, or replace this with your OpenAI-compatible provider.
OPENAI_API_KEY=replace-with-your-key
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# Optional local service overrides.
API_PORT=8080
WEB_PORT=5173
# API_URL=http://localhost:8080