# Copy this file to .env before running `pnpm dev`.
# Never commit a real .env file.

# PostgreSQL used for saved conversations and messages.
# This works with common local PostgreSQL installations that use your
# operating-system username. If your server requires password auth, use:
# postgresql://USER:PASSWORD@localhost:5432/lumina
DATABASE_URL=postgresql://localhost:5432/lumina

# OpenAI or another OpenAI-compatible provider.
OPENAI_API_KEY=replace-with-your-key
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# Optional local overrides.
API_PORT=8080
WEB_PORT=5173
# API_URL=http://localhost:8080