# Copy this file to .env before running `pnpm dev`.
# Never commit a real .env file.

# PostgreSQL used for saved conversations and messages.
# For the Ubuntu setup in README.md, replace YOUR_PASSWORD with the password
# chosen for lumina_user. If your local PostgreSQL uses OS-user auth instead,
# use: postgresql://localhost:5432/lumina
DATABASE_URL=postgresql://lumina_user:YOUR_PASSWORD@localhost:5432/lumina

# ── AI provider (OpenAI, or any OpenAI-compatible provider) ──────────────────
# Every AI feature uses this one key: Chat, Search, Write and Translate call the
# chat-completions API, Artist calls the images API. Get an OpenAI key from
# https://platform.openai.com/account/api-keys (other providers such as Groq
# work too — use their key page and their base URL below).
#
# The server reads .env ONCE at startup, so restart `pnpm dev` after editing it.
# A key that is empty or still one of the placeholder shapes below ("replace",
# "your-key", "changeme", "xxx", "<your-key>") counts as *not configured*: the
# server refuses to start and names the variable, instead of failing on your
# first message. Values are never printed, logged or sent to the browser.
OPENAI_API_KEY=replace-with-your-key
# Required. https://api.openai.com/v1 for OpenAI, https://api.groq.com/openai/v1
# for Groq, etc. It must include the scheme; a malformed value stops startup.
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
# Optional: a separate key for the same provider. Falls back to OPENAI_API_KEY.
# AI_INTEGRATIONS_OPENAI_API_KEY=
#
# What a provider failure looks like in the UI (details in README →
# Troubleshooting local setup): a rejected key is answered as
# "The AI service is not configured correctly. Please contact the administrator.",
# an exhausted quota as "The AI service is busy or over quota. Please try again
# later.", and a timeout as "The AI service did not respond. Please try again."
# The provider's own message (and any key it echoes) is only ever written to the
# API log, redacted and with the request id.

# Optional local overrides.
API_PORT=8080
WEB_PORT=5173
# API_URL=http://localhost:8080

# How long PostgreSQL may take to answer before the API gives up (seconds).
# The startup check and GET /api/health use this; without it a wrong host in
# DATABASE_URL can hang instead of failing with a clear message.
# PGCONNECT_TIMEOUT=5

# API log level: debug, info (default), warn or error. The API logs the real
# cause of every 500 at error level, with the request id.
# LOG_LEVEL=info

# Session signing secret for auth cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-random-32-plus-character-secret

# Session cookie Secure flag. Defaults to on when NODE_ENV=production and off
# otherwise (dev serves plain HTTP). Set to 1 to force it on, or 0 to force it
# off (e.g. TLS terminates at a proxy without NODE_ENV=production).
# COOKIE_SECURE=1

# Set to 1 so the first registered account adopts conversations that existed
# before authentication was added (rows with no owner). Leave unset for fresh
# databases.
# AUTH_AUTO_PROVISION=1

# Optional extra CORS origins (comma-separated) when the API is consumed by
# other frontends. Same-origin requests always work.
# CORS_ORIGINS=http://localhost:3000

# Number of trusted reverse-proxy hops in front of the API. Leave unset (0)
# when clients connect directly. Set to 1 behind a single reverse proxy (e.g.
# nginx or the Vite dev proxy) so rate limiting keys on the real client IP
# from X-Forwarded-For instead of lumping every user into the proxy's bucket.
# TRUST_PROXY_HOPS=1