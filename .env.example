# Copy this file to .env before running `pnpm dev`.
# Never commit a real .env file.

# PostgreSQL used for saved conversations and messages.
# For the Ubuntu setup in README.md, replace YOUR_PASSWORD with the password
# chosen for lumina_user. If your local PostgreSQL uses OS-user auth instead,
# use: postgresql://localhost:5432/lumina
DATABASE_URL=postgresql://lumina_user:YOUR_PASSWORD@localhost:5432/lumina

# OpenAI or another OpenAI-compatible provider.
OPENAI_API_KEY=replace-with-your-key
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# Optional local overrides.
API_PORT=8080
WEB_PORT=5173
# API_URL=http://localhost:8080

# Session signing secret for auth cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-random-32-plus-character-secret

# Session cookie Secure flag. Defaults to on when NODE_ENV=production and off
# otherwise (dev serves plain HTTP). Set to 1 to force it on, or 0 to force it
# off (e.g. TLS terminates at a proxy without NODE_ENV=production).
# COOKIE_SECURE=1

# Set to 1 so the first registered account adopts conversations that existed
# before authentication was added (rows with no owner). Leave unset for fresh
# databases.
# AUTH_AUTO_PROVISION=1

# Optional extra CORS origins (comma-separated) when the API is consumed by
# other frontends. Same-origin requests always work.
# CORS_ORIGINS=http://localhost:3000

# Number of trusted reverse-proxy hops in front of the API. Leave unset (0)
# when clients connect directly. Set to 1 behind a single reverse proxy (e.g.
# nginx or the Vite dev proxy) so rate limiting keys on the real client IP
# from X-Forwarded-For instead of lumping every user into the proxy's bucket.
# TRUST_PROXY_HOPS=1